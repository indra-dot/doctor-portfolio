<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>adjustrEMD Pro - Endocrine & Metabolic Emergency CDSS</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-main: #040814;
            --glass-bg: rgba(15, 23, 42, 0.78);
            --glass-bg-hover: rgba(22, 34, 60, 0.90);
            --glass-border: rgba(255, 255, 255, 0.09);
            --glass-border-hover: rgba(16, 185, 129, 0.45);
            --text-heading: #F8FAFC;
            --text-secondary: #94A3B8;
            --text-muted: #64748B;
            --accent-emerald: #10B981;
            --accent-cyan: #00F2FE;
            --accent-blue: #38BDF8;
            --accent-amber: #F59E0B;
            --accent-rose: #EF4444;
            --accent-purple: #C084FC;
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
            --btn-gradient: linear-gradient(135deg, #10B981 0%, #0284C7 100%);
            --radius-pill: 9999px;
            --radius-lg: 20px;
            --radius-md: 14px;
            --radius-sm: 8px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-secondary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Ambient Glow Effects matching adjustr-GEH */
        .ambient-glow-1 {
            position: fixed; top: -120px; left: 10%; width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.10) 0%, transparent 65%);
            filter: blur(80px); z-index: -1; pointer-events: none;
        }
        .ambient-glow-2 {
            position: fixed; bottom: 5%; right: 8%; width: 480px; height: 480px;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.08) 0%, transparent 65%);
            filter: blur(80px); z-index: -1; pointer-events: none;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.16); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
        }

        .glass-card, .card {
            background: var(--glass-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            box-shadow: var(--glass-shadow);
            transition: all 0.22s ease;
            width: 100%;
            box-sizing: border-box;
            padding: 1.5rem;
        }
        @media (min-width: 640px) {
            .glass-card, .card {
                padding: 1.75rem 2rem;
            }
        }
        button.glass-card {
            padding: 1.25rem !important;
        }
        .glass-card:hover, .card:hover {
            border-color: var(--glass-border-hover);
            box-shadow: 0 8px 30px 0 rgba(16, 185, 129, 0.16);
            transform: translateY(-2px);
        }

        .input-modern, select, textarea {
            background: rgba(30, 41, 59, 0.65) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-heading) !important;
            border-radius: var(--radius-sm);
            padding: 0.55rem 0.85rem;
            width: 100%;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }
        .input-modern:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-emerald) !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2) !important;
        }

        /* Checkbox modern */
        .checkbox-modern {
            appearance: none;
            width: 1.2rem;
            height: 1.2rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 0.375rem;
            background-color: rgba(30, 41, 59, 0.65);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        .checkbox-modern:checked {
            background-color: var(--accent-emerald);
            border-color: var(--accent-emerald);
        }
        .checkbox-modern:checked::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: white;
            font-size: 0.7rem;
        }

        /* Quick Navigation Bar */
        .quick-nav-bar {
            background: rgba(4, 8, 20, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--glass-border);
            position: sticky;
            top: 56px;
            z-index: 30;
            padding: 0.5rem 1rem;
        }
        .quick-nav-scroll {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            max-width: 1200px;
            margin: 0 auto;
        }
        .quick-nav-scroll::-webkit-scrollbar { display: none; }

        .quick-nav-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.4rem 0.85rem;
            border-radius: var(--radius-pill);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            font-size: 0.78rem;
            font-weight: 500;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .quick-nav-pill:hover {
            background: rgba(255, 255, 255, 0.09);
            color: #FFFFFF;
            border-color: rgba(16, 185, 129, 0.35);
        }
        .quick-nav-pill.active {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.22) 0%, rgba(2, 132, 199, 0.25) 100%);
            border-color: var(--accent-emerald);
            color: #FFFFFF;
            font-weight: 600;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.45rem 0.95rem;
            border-radius: var(--radius-pill);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 1.25rem;
        }
        .btn-back:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #FFFFFF;
            border-color: var(--accent-emerald);
            transform: translateX(-2px);
        }

        /* Clinical Pearl Box */
        .pearl-box {
            background: linear-gradient(to right, rgba(16, 185, 129, 0.08), rgba(15, 23, 42, 0.4));
            border-left: 3px solid var(--accent-emerald);
            border-radius: var(--radius-md);
            padding: 1.15rem 1.35rem;
            margin-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        #toast-notice {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
        }
    </style>
</head>
<body class="selection:bg-emerald-900 selection:text-emerald-100">

    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <!-- Toast Notification (Matching adjustr-GEH) -->
    <div id="toast-notice" class="fixed bottom-6 right-6 z-50 flex items-center space-x-3 px-5 py-3 rounded-xl bg-slate-900/95 border border-emerald-500/50 shadow-[0_10px_35px_rgba(16,185,129,0.3)] text-white text-sm font-medium translate-y-24 opacity-0 pointer-events-none">
        <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toast-message">Resume klinis CPPT berhasil disalin!</span>
    </div>

    <!-- Main Container -->
    <div class="flex flex-col min-h-screen">
        
        <!-- Top Sticky Header -->
        <header class="h-14 glass-panel sticky top-0 z-40 border-t-0 border-x-0 rounded-none flex items-center justify-between px-3 sm:px-6 gap-2">
            <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="flex items-center space-x-2 sm:space-x-2.5 cursor-pointer text-left">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-400/20 to-teal-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 shrink-0">
                        <i class="fa-solid fa-bolt-lightning text-base"></i>
                    </div>
                    <div>
                        <span class="text-white font-bold text-sm tracking-tight block leading-tight font-['Plus_Jakarta_Sans']">adjustrEMD Pro</span>
                        <span class="text-[10px] text-emerald-400 font-medium block leading-tight">Endocrine & Metabolic CDSS</span>
                    </div>
                </button>
                <div class="h-4 w-px bg-white/10 hidden md:block"></div>
                <div class="hidden md:block">
                    <h2 id="header-title" class="text-xs font-semibold text-slate-200 truncate max-w-[160px] lg:max-w-none">Home Dashboard</h2>
                </div>
            </div>

            <!-- Top Search Bar (Realtime Calculator Discovery) -->
            <div class="relative flex-1 max-w-xs sm:max-w-md mx-1 sm:mx-4" id="header-search-container">
                <div class="relative flex items-center">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 text-slate-400 text-xs pointer-events-none"></i>
                    <input type="text" id="global-search-input" placeholder="Cari kalkulator (e.g. BWPS, Wayne, Osmolaritas, Anion Gap, TyG, Bridging)..." autocomplete="off" class="w-full pl-8 pr-14 py-1.5 rounded-full bg-slate-900/80 border border-slate-700/70 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-all">
                    <span class="hidden sm:inline-block absolute right-2.5 px-1.5 py-0.5 text-[9px] font-mono text-slate-400 bg-slate-800 rounded border border-slate-700 pointer-events-none">Ctrl K</span>
                    <button id="search-clear-btn" type="button" onclick="clearGlobalSearch()" class="hidden absolute right-2.5 text-slate-400 hover:text-white text-xs px-1">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <!-- Search Results Dropdown -->
                <div id="search-results-dropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-slate-900/95 backdrop-blur-xl border border-emerald-500/30 rounded-xl shadow-[0_12px_40px_rgba(0,0,0,0.85)] z-50 max-h-96 overflow-y-auto p-2"></div>
            </div>

            <div class="flex items-center space-x-2 shrink-0">
                <span class="px-2.5 py-0.5 text-[11px] rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-medium hidden sm:inline-block">10 Tools</span>
                <a href="mailto:putrawan.2371041010@student.unud.ac.id" target="_blank" rel="noopener" class="px-2.5 py-1 text-xs rounded-full bg-white/5 hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-300 border border-white/10 transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-envelope text-[11px]"></i>
                    <span class="hidden md:inline">Feedback</span>
                </a>
            </div>
        </header>

        <!-- Sticky Quick Navigation Bar (Horizontal Scrollable Pills) -->
        <nav class="quick-nav-bar" aria-label="Quick Category Switcher">
            <div class="quick-nav-scroll">
                <button type="button" id="pill-dash" onclick="navigateTo('home-module', 'Home Dashboard', this.id)" class="quick-nav-pill active">
                    <i class="fa-solid fa-house text-emerald-400 text-xs"></i>
                    <span>Dashboard</span>
                </button>
                <button type="button" id="pill-thyroid" onclick="navigateTo('tab-thyroid', 'Tiroid & Krisis', this.id)" class="quick-nav-pill">
                    <i class="fa-solid fa-fire text-rose-400 text-xs"></i>
                    <span>Tiroid (BWPS & Wayne)</span>
                </button>
                <button type="button" id="pill-emergencies" onclick="navigateTo('tab-emergencies', 'Emergensi Metabolik & Dosing', this.id)" class="quick-nav-pill">
                    <i class="fa-solid fa-truck-medical text-amber-400 text-xs"></i>
                    <span>Emergensi & Osmolaritas</span>
                </button>
                <button type="button" id="pill-metabolic" onclick="navigateTo('tab-metabolic', 'Kardiometabolik & Lipid', this.id)" class="quick-nav-pill">
                    <i class="fa-solid fa-chart-pie text-violet-400 text-xs"></i>
                    <span>Metabolik (TyG & HOMA)</span>
                </button>
                <button type="button" id="pill-bridging-insulin" onclick="navigateTo('tab-bridging-insulin', 'Bridging Insulin IV ke SC', this.id)" class="quick-nav-pill">
                    <i class="fa-solid fa-syringe text-orange-400 text-xs"></i>
                    <span>Bridging Insulin</span>
                </button>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-6xl mx-auto z-10">

            <!-- ======================================================== -->
            <!-- LEVEL 0: HOME DASHBOARD                                  -->
            <!-- ======================================================== -->
            <section id="home-module" class="module-section block">
                
                <!-- Welcome Banner -->
                <div class="glass-card rounded-2xl p-6 sm:p-7 mb-7 relative overflow-hidden border-t-2 border-t-emerald-400/50">
                    <div class="absolute -right-6 -top-6 opacity-10 pointer-events-none">
                        <i class="fa-solid fa-bolt-lightning text-9xl text-emerald-400"></i>
                    </div>
                    <div class="relative z-10">
                        <span class="px-2.5 py-0.5 bg-emerald-500/20 text-emerald-300 text-xs font-semibold rounded-full border border-emerald-500/30 inline-block mb-2">
                            Evidence-Based Medicine
                        </span>
                        <h2 class="text-xl sm:text-2xl font-extrabold text-white font-['Plus_Jakarta_Sans']">
                            adjustrEMD <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">Pro CDSS</span>
                        </h2>
                        <p class="text-slate-300 max-w-3xl text-xs sm:text-sm mt-1 leading-relaxed">
                            Sistem pendukung keputusan klinis (CDSS) Kedaruratan Endokrin, Metabolik, dan Kardiometabolik: Stratifikasi badai tiroid & hipotiroid (BWPS, Wayne, Billewicz), krisis hiperglikemia (Osmolaritas Serum Efektif, Anion Gap, Koreksi Natrium), dosis awal insulin basal-bolus TDD, evaluasi resistensi insulin & profil lipid (TyG, HOMA-IR, Friedewald LDL), serta protokol bridging titrasi drip insulin IV 24 jam ke regimen subkutan.
                        </p>
                    </div>
                </div>

                <!-- Category & Tool Grid -->
                <h3 class="text-sm font-bold text-white mb-3 flex items-center justify-between">
                    <span>Modul Endokrin & Kedaruratan Metabolik</span>
                    <span class="text-xs text-slate-400 font-normal">Pilih modul klinis untuk membuka alat kalkulasi</span>
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    
                    <!-- 1. Tiroid -->
                    <button type="button" onclick="navigateTo('tab-thyroid', 'Tiroid & Krisis', 'pill-thyroid')" class="glass-card rounded-xl p-5 flex flex-col items-start text-left cursor-pointer group w-full">
                        <div class="h-11 w-11 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-fire"></i>
                        </div>
                        <h4 class="font-bold text-white text-base mb-1 group-hover:text-emerald-400 transition-colors">1. Skoring Krisis & Disfungsi Tiroid</h4>
                        <p class="text-xs text-slate-400 line-clamp-2 mb-3">Burch-Wartofsky Point Scale (BWPS) untuk badai tiroid, Wayne's Clinical Index untuk hipertiroid klinis, dan Billewicz Score untuk hipotiroidisme.</p>
                        <span class="mt-auto text-xs text-rose-400 font-semibold flex items-center">Buka Modul Tiroid <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i></span>
                    </button>

                    <!-- 2. Emergensi Metabolik -->
                    <button type="button" onclick="navigateTo('tab-emergencies', 'Emergensi Metabolik & Dosing', 'pill-emergencies')" class="glass-card rounded-xl p-5 flex flex-col items-start text-left cursor-pointer group w-full">
                        <div class="h-11 w-11 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-truck-medical"></i>
                        </div>
                        <h4 class="font-bold text-white text-base mb-1 group-hover:text-emerald-400 transition-colors">2. Kedaruratan Metabolik & DKA/HHS</h4>
                        <p class="text-xs text-slate-400 line-clamp-2 mb-3">Osmolaritas serum efektif (tonisitas), Anion Gap terkoreksi & pseudohiponatremia, serta inisiasi dosis harian total (TDD) insulin basal-bolus.</p>
                        <span class="mt-auto text-xs text-amber-400 font-semibold flex items-center">Buka Modul Emergensi <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i></span>
                    </button>

                    <!-- 3. Kardiometabolik & Lipid -->
                    <button type="button" onclick="navigateTo('tab-metabolic', 'Kardiometabolik & Lipid', 'pill-metabolic')" class="glass-card rounded-xl p-5 flex flex-col items-start text-left cursor-pointer group w-full">
                        <div class="h-11 w-11 rounded-lg bg-violet-500/10 text-violet-400 border border-violet-500/20 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <h4 class="font-bold text-white text-base mb-1 group-hover:text-emerald-400 transition-colors">3. Kardiometabolik & Lipidologi</h4>
                        <p class="text-xs text-slate-400 line-clamp-2 mb-3">TyG Index (Triglyceride-Glucose), model HOMA-IR resistensi insulin, dan estimasi LDL-C formula Friedewald dengan batas aman trigliserida.</p>
                        <span class="mt-auto text-xs text-violet-400 font-semibold flex items-center">Buka Modul Kardiometabolik <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i></span>
                    </button>

                    <!-- 4. Bridging Insulin -->
                    <button type="button" onclick="navigateTo('tab-bridging-insulin', 'Bridging Insulin IV ke SC', 'pill-bridging-insulin')" class="glass-card rounded-xl p-5 flex flex-col items-start text-left cursor-pointer group w-full">
                        <div class="h-11 w-11 rounded-lg bg-orange-500/10 text-orange-400 border border-orange-500/20 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-syringe"></i>
                        </div>
                        <h4 class="font-bold text-white text-base mb-1 group-hover:text-emerald-400 transition-colors">4. Bridging Insulin: Transisi IV ke Subkutan</h4>
                        <p class="text-xs text-slate-400 line-clamp-2 mb-3">Titrasi drip insulin 24 jam ke regimen basal-bolus 80%, instruksi overlap kritis 1-2 jam, dan salin ringkasan ke rekam medis CPPT.</p>
                        <span class="mt-auto text-xs text-orange-400 font-semibold flex items-center">Buka Bridging Insulin <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i></span>
                    </button>

                </div>
            </section>

            <!-- ================= MODULE 1: THYROID SCORING ================= -->
            <section id="tab-thyroid" class="module-section hidden space-y-6 md:space-y-8">
        <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
        </button>

        
        <!-- BWPS -->
        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8 flex flex-col group/card">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-slate-800/80 gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                Burch-Wartofsky Point Scale
                <span class="text-[11px] bg-slate-800/80 border border-slate-700 text-slate-300 px-2.5 py-0.5 rounded-full font-medium tracking-wide">Thyroid Storm</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Diagnostic criteria for thyrotoxic crisis.</p>
            </div>
            <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center bg-slate-900/60 border border-slate-800/80 rounded-xl px-4 py-2.5 sm:px-5 sm:py-3 shrink-0 min-w-[150px]">
              <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 tracking-tight leading-none" id="res-bwps">0</div>
              <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1 sm:mt-1.5 text-right" id="res-bwps-interp">Unlikely</div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Temperature (°C)</label>
              <select id="bwps-temp" class="input-modern bwps-input">
                <option value="0">&lt; 37.2</option>
                <option value="5">37.2 - 37.7</option>
                <option value="10">37.8 - 38.3</option>
                <option value="15">38.4 - 38.8</option>
                <option value="20">38.9 - 39.3</option>
                <option value="25">39.4 - 39.9</option>
                <option value="30">&ge; 40.0</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Central Nervous System</label>
              <select id="bwps-cns" class="input-modern bwps-input">
                <option value="0">Absent</option>
                <option value="10">Mild (Agitation)</option>
                <option value="20">Moderate (Delirium, Psychosis, Extreme Lethargy)</option>
                <option value="30">Severe (Seizures, Coma)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Gastrointestinal / Hepatic</label>
              <select id="bwps-gi" class="input-modern bwps-input">
                <option value="0">Absent</option>
                <option value="10">Moderate (Diarrhea, Nausea/Vomiting, Abdominal pain)</option>
                <option value="20">Severe (Unexplained Jaundice)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Cardiovascular (Heart Rate)</label>
              <select id="bwps-hr" class="input-modern bwps-input">
                <option value="0">&lt; 90</option>
                <option value="5">90 - 109</option>
                <option value="10">110 - 119</option>
                <option value="15">120 - 129</option>
                <option value="20">130 - 139</option>
                <option value="25">&ge; 140</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Congestive Heart Failure</label>
              <select id="bwps-chf" class="input-modern bwps-input">
                <option value="0">Absent</option>
                <option value="5">Mild (Pedal Edema)</option>
                <option value="10">Moderate (Bibasilar Rales)</option>
                <option value="15">Severe (Pulmonary Edema)</option>
              </select>
            </div>
            <div class="flex flex-col gap-4 justify-center md:pt-6 bg-slate-900/30 p-3 rounded-lg border border-slate-800/50">
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" id="bwps-af" value="10" class="checkbox-modern bwps-input">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Atrial Fibrillation Present</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" id="bwps-precipitant" value="10" class="checkbox-modern bwps-input">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Precipitating History Present</span>
              </label>
            </div>
          </div>

          <div class="pearl-box">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-emerald-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Highly sensitive (near 100%) but lacks specificity. Scores can be elevated in severe non-thyroidal illness (e.g., sepsis). Always correlate clinically. Score < 25 effectively rules out storm; 25-44 is impending; ≥45 is diagnostic.</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-emerald-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">If Score ≥ 45, admit to ICU. Sequence: 1) Beta-blockade (Propranolol) → 2) Thionamide (PTU preferred) → 3) Iodine (Lugol's, 1 hr <span class="italic font-semibold">after</span> thionamide to block new thyroid hormone synthesis / prevent Jod-Basedow effect) → 4) Glucocorticoids.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Wayne's Index -->
        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-slate-800/80 gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                Wayne's Clinical Index
                <span class="text-[11px] bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 px-2.5 py-0.5 rounded-full font-medium tracking-wide">Hyperthyroidism</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Diagnosis of clinical hyperthyroidism.</p>
            </div>
            <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center bg-slate-900/60 border border-slate-800/80 rounded-xl px-4 py-2.5 sm:px-5 sm:py-3 shrink-0 min-w-[150px]">
              <div class="text-3xl sm:text-4xl font-extrabold text-cyan-400 tracking-tight leading-none" id="res-wayne">0</div>
              <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1 sm:mt-1.5 text-right" id="res-wayne-interp">Euthyroid</div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
            <!-- Symptoms (Left) -->
            <div class="space-y-3 bg-slate-900/20 p-4 rounded-xl border border-slate-800/40">
              <h3 class="text-xs font-bold text-slate-500 mb-3 uppercase tracking-wider">Symptoms</h3>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Dyspnoea on exertion (+1)</span>
                <input type="checkbox" value="1" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Palpitations (+2)</span>
                <input type="checkbox" value="2" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Tiredness (+2)</span>
                <input type="checkbox" value="2" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Preference for heat (-5)</span>
                <input type="checkbox" value="-5" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Preference for cold (+5)</span>
                <input type="checkbox" value="5" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Excessive sweating (+3)</span>
                <input type="checkbox" value="3" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Nervousness (+2)</span>
                <input type="checkbox" value="2" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Appetite increased (+3)</span>
                <input type="checkbox" value="3" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Appetite decreased (-3)</span>
                <input type="checkbox" value="-3" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Weight increased (-3)</span>
                <input type="checkbox" value="-3" class="checkbox-modern wayne-input">
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Weight decreased (+3)</span>
                <input type="checkbox" value="3" class="checkbox-modern wayne-input">
              </label>
            </div>
            
            <!-- Signs (Right) -->
            <div class="space-y-3 bg-slate-900/20 p-4 rounded-xl border border-slate-800/40 flex flex-col">
              <h3 class="text-xs font-bold text-slate-500 mb-3 uppercase tracking-wider">Signs</h3>
              <div class="space-y-3 flex-1">
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Palpable thyroid (+3)</span>
                  <input type="checkbox" value="3" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Bruit over thyroid (+2)</span>
                  <input type="checkbox" value="2" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Exophthalmos (+2)</span>
                  <input type="checkbox" value="2" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Lid retraction (+2)</span>
                  <input type="checkbox" value="2" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Lid lag (+1)</span>
                  <input type="checkbox" value="1" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Hyperkinetic movements (+4)</span>
                  <input type="checkbox" value="4" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Fine finger tremor (+1)</span>
                  <input type="checkbox" value="1" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Hot hands (+2)</span>
                  <input type="checkbox" value="2" class="checkbox-modern wayne-input">
                </label>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="text-sm text-slate-300 group-hover:text-white transition-colors">Moist hands (+1)</span>
                  <input type="checkbox" value="1" class="checkbox-modern wayne-input">
                </label>
              </div>
              
              <div class="mt-4 pt-4 border-t border-slate-700/50">
                <label class="block text-xs font-medium text-slate-400 mb-1.5">Heart Rate / Pulse</label>
                <select id="wayne-pulse" class="input-modern wayne-input">
                  <option value="0">Normal</option>
                  <option value="-3">&lt; 80 bpm (-3)</option>
                  <option value="3">&gt; 90 bpm (+3)</option>
                  <option value="4">Atrial Fibrillation (+4)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="pearl-box !border-cyan-500 !bg-gradient-to-r !from-cyan-500/10 !to-transparent">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-cyan-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Excellent for outpatient clinical diagnosis of thyrotoxicosis before labs result. Useful in resource-limited settings to justify empiric symptom management. Score < 11 is Euthyroid, 11-19 Equivocal, >19 Toxic.</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-cyan-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Correlate with FT4, TSH, and TRAb (if Graves' suspected). Control sympathomimetic symptoms with beta-blockers immediately. Consider definitive therapy (RAI or Surgery) based on workup.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Billewicz Score -->
        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-slate-800/80 gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                Billewicz Score
                <span class="text-[11px] bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 px-2.5 py-0.5 rounded-full font-medium tracking-wide">Hypothyroidism</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Diagnostic index for clinical hypothyroidism.</p>
            </div>
            <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center bg-slate-900/60 border border-slate-800/80 rounded-xl px-4 py-2.5 sm:px-5 sm:py-3 shrink-0 min-w-[150px]">
              <div class="text-3xl sm:text-4xl font-extrabold text-indigo-400 tracking-tight leading-none" id="res-billewicz">-51</div>
              <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1 sm:mt-1.5 text-right" id="res-billewicz-interp">Euthyroid</div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Parameter Dropdowns -->
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Diminished Sweating</label>
              <select class="input-modern billewicz-input">
                <option value="-2">Absent (-2)</option>
                <option value="6">Present (+6)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Dry Skin</label>
              <select class="input-modern billewicz-input">
                <option value="-6">Absent (-6)</option>
                <option value="3">Present (+3)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Cold Intolerance</label>
              <select class="input-modern billewicz-input">
                <option value="-5">Absent (-5)</option>
                <option value="4">Present (+4)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Weight Increase</label>
              <select class="input-modern billewicz-input">
                <option value="-1">Absent (-1)</option>
                <option value="1">Present (+1)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Constipation</label>
              <select class="input-modern billewicz-input">
                <option value="-1">Absent (-1)</option>
                <option value="2">Present (+2)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Hoarseness</label>
              <select class="input-modern billewicz-input">
                <option value="-6">Absent (-6)</option>
                <option value="5">Present (+5)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Paresthesia</label>
              <select class="input-modern billewicz-input">
                <option value="-4">Absent (-4)</option>
                <option value="5">Present (+5)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Hearing Impairment</label>
              <select class="input-modern billewicz-input">
                <option value="0">Absent (0)</option>
                <option value="2">Present (+2)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Slow Movements</label>
              <select class="input-modern billewicz-input">
                <option value="-3">Absent (-3)</option>
                <option value="11">Present (+11)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Delayed Ankle Jerk</label>
              <select class="input-modern billewicz-input">
                <option value="-6">Absent (-6)</option>
                <option value="15">Present (+15)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Coarse Skin</label>
              <select class="input-modern billewicz-input">
                <option value="-7">Absent (-7)</option>
                <option value="7">Present (+7)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Cold Skin</label>
              <select class="input-modern billewicz-input">
                <option value="-2">Absent (-2)</option>
                <option value="3">Present (+3)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Periorbital Puffiness</label>
              <select class="input-modern billewicz-input">
                <option value="-6">Absent (-6)</option>
                <option value="4">Present (+4)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Pulse Rate</label>
              <select class="input-modern billewicz-input">
                <option value="0">75 - 85 bpm (0)</option>
                <option value="4">&lt; 75 bpm (+4)</option>
                <option value="-4">&gt; 85 bpm (-4)</option>
              </select>
            </div>
          </div>

          <div class="pearl-box !border-indigo-500 !bg-gradient-to-r !from-indigo-500/10 !to-transparent">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-indigo-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Symptoms of hypothyroidism are insidious and often dismissed as normal aging or depression. A high score (≥ 25) warrants comprehensive screening. Delayed ankle jerk reflex (Woltman's sign) is highly specific (+15 points).</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-indigo-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Initiate Levothyroxine low and slow (e.g., 12.5-25 mcg/day), especially in elderly patients or those with ischemic heart disease to prevent precipitating angina. Recheck TSH in 6-8 weeks.</p>
              </div>
            </div>
          </div>
        </div>

      </section>

            <!-- ================= MODULE 2: EMERGENCIES & DOSING ================= -->
            <section id="tab-emergencies" class="module-section hidden space-y-6 md:space-y-8">
        <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
        </button>

        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
          <!-- Osmolarity -->
          <div class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800/80 gap-3">
                <div>
                  <h2 class="text-lg sm:text-xl font-bold text-white">Effective Serum Osmolarity</h2>
                  <p class="text-xs text-slate-400 mt-0.5">Tonicity Assessment</p>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-3.5 py-2 shrink-0 text-right">
                  <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 tracking-tight leading-none" id="res-osmo">-</div>
                  <div class="text-[10px] text-slate-400 mt-0.5 uppercase font-semibold">mOsm/kg</div>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Measured Sodium [mEq/L]</label>
                  <input type="number" id="osmo-na" class="input-modern" placeholder="e.g. 140">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Glucose [mg/dL]</label>
                  <input type="number" id="osmo-glu" class="input-modern" placeholder="e.g. 600">
                </div>
              </div>
            </div>
            
            <div class="pearl-box !border-amber-500 !bg-gradient-to-r !from-amber-500/10 !to-transparent mt-5">
              <p class="text-[13px] text-slate-300 mb-3"><span class="text-amber-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Clinical Pearl</span> Mental status in hyperglycemic emergencies correlates directly with effective osmolarity (>320 typically causes obtundation), not absolute glucose. Effective osmolarity excludes BUN because it freely crosses cell membranes.</p>
              <p class="text-[13px] text-slate-300"><span class="text-amber-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Next Step</span> Aggressive isotonic fluid resuscitation (0.9% NaCl) is the primary step before initiating insulin in HHS to prevent vascular collapse.</p>
            </div>
          </div>

          <!-- Anion Gap & Corrected Na -->
          <div class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800/80 gap-3">
                <div>
                  <h2 class="text-lg sm:text-xl font-bold text-white">Anion Gap & Corr. Na</h2>
                  <p class="text-xs text-slate-400 mt-0.5">Acid-Base & Pseudohyponatremia</p>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-3.5 py-2 shrink-0 flex items-center gap-3">
                  <div class="text-right">
                    <span class="text-[10px] text-slate-400 uppercase font-semibold block">AG</span>
                    <span class="text-xl sm:text-2xl font-extrabold text-emerald-400 tracking-tight leading-none" id="res-ag">-</span>
                  </div>
                  <div class="h-6 w-px bg-slate-800"></div>
                  <div class="text-right">
                    <span class="text-[10px] text-slate-400 uppercase font-semibold block">cNa</span>
                    <span class="text-xl sm:text-2xl font-extrabold text-cyan-400 tracking-tight leading-none" id="res-cna">-</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Na [mEq/L]</label>
                  <input type="number" id="ag-na" class="input-modern" placeholder="140">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Cl [mEq/L]</label>
                  <input type="number" id="ag-cl" class="input-modern" placeholder="100">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">HCO3 [mEq/L]</label>
                  <input type="number" id="ag-hco3" class="input-modern" placeholder="24">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Glucose [mg/dL]</label>
                  <input type="number" id="ag-glu" class="input-modern" placeholder="250">
                </div>
              </div>
            </div>
            
            <div class="pearl-box mt-5">
              <p class="text-[13px] text-slate-300 mb-3"><span class="text-emerald-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Clinical Pearl</span> The Delta Gap is crucial to unmasking hidden mixed acid-base disorders in DKA (e.g., concurrent NAGMA from NS resuscitation). Pseudohyponatremia is common due to osmotic shifts.</p>
              <p class="text-[13px] text-slate-300"><span class="text-emerald-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Next Step</span> Transition from Normal Saline to half-Normal Saline (0.45%) if corrected Na is normal or high to prevent hyperchloremic metabolic acidosis. Add Dextrose 5% when glucose drops < 200 mg/dL.</p>
            </div>
          </div>
        </div>

        <!-- Insulin Basal-Bolus -->
        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-slate-800/80 gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                Insulin Basal-Bolus TDD
                <span class="text-[11px] bg-rose-500/10 border border-rose-500/20 text-rose-300 px-2.5 py-0.5 rounded-full font-medium tracking-wide">Physiologic Dosing</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Weight-based total daily dose distribution.</p>
            </div>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-4 py-2.5 sm:px-5 sm:py-3 shrink-0 flex sm:flex-col items-center sm:items-end justify-between sm:justify-center min-w-[150px]">
              <div class="text-3xl sm:text-4xl font-extrabold text-rose-400 tracking-tight leading-none" id="res-tdd">-</div>
              <div class="text-[11px] sm:text-xs text-slate-400 font-semibold mt-1 sm:mt-1.5 uppercase tracking-wide text-right">Total Units / Day</div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1.5">Body Weight (kg)</label>
                <input type="number" id="ins-wt" class="input-modern" placeholder="e.g. 70">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1.5">TDD Factor (Units/kg)</label>
                <select id="ins-factor" class="input-modern">
                  <option value="0.3">0.3 (Sensitive / Elderly / CKD)</option>
                  <option value="0.4">0.4</option>
                  <option value="0.5" selected>0.5 (Standard)</option>
                  <option value="0.6">0.6 (Resistant / Obese)</option>
                </select>
              </div>
            </div>
            
            <div class="bg-slate-900/40 p-5 rounded-xl border border-slate-800/60 flex flex-col justify-center">
              <div class="flex justify-between items-center mb-4 pb-4 border-b border-slate-700/50">
                <span class="text-sm font-medium text-slate-300">Basal (50%)</span>
                <span class="font-bold text-2xl text-rose-300 tracking-tighter" id="res-basal">- <span class="text-sm font-medium text-slate-400 ml-1">U Qd</span></span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm font-medium text-slate-300">Bolus (50% div 3 meals)</span>
                <span class="font-bold text-2xl text-rose-300 tracking-tighter" id="res-bolus">- <span class="text-sm font-medium text-slate-400 ml-1">U TID</span></span>
              </div>
            </div>
          </div>

          <div class="pearl-box !border-rose-500 !bg-gradient-to-r !from-rose-500/10 !to-transparent mt-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-rose-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Sliding scale insulin alone is discouraged in the wards as it creates a "rollercoaster" of glycemic variability and reactive hypoglycemia. Physiologic basal-bolus mimics endogenous pancreatic secretion.</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-rose-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Titrate Basal dose based on fasting morning glucose. Titrate Bolus based on pre-meal glucose levels. If NPO, hold nutritional bolus but continue basal (and potentially add correctional scale).</p>
              </div>
            </div>
          </div>
        </div>
      </section>

            <!-- ================= MODULE 3: METABOLIC & RISK ================= -->
            <section id="tab-metabolic" class="module-section hidden space-y-6 md:space-y-8">
        <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
        </button>

        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
          <!-- TyG Index -->
          <div class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800/80 gap-3">
                <div>
                  <h2 class="text-lg sm:text-xl font-bold text-white">TyG Index</h2>
                  <p class="text-xs text-slate-400 mt-0.5">Triglyceride-Glucose Surrogate</p>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-3.5 py-2 shrink-0 text-right">
                  <div class="text-2xl sm:text-3xl font-extrabold text-fuchsia-400 tracking-tight leading-none" id="res-tyg">-</div>
                  <div class="text-[10px] text-slate-400 mt-0.5 uppercase font-semibold">Cutoff 4.49</div>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Fasting Triglycerides [mg/dL]</label>
                  <input type="number" id="tyg-tg" class="input-modern" placeholder="e.g. 150">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Fasting Glucose [mg/dL]</label>
                  <input type="number" id="tyg-glu" class="input-modern" placeholder="e.g. 100">
                </div>
              </div>
            </div>
            
            <div class="pearl-box !border-fuchsia-500 !bg-gradient-to-r !from-fuchsia-500/10 !to-transparent mt-5">
              <p class="text-[13px] text-slate-300 mb-3"><span class="text-fuchsia-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Clinical Pearl</span> A highly sensitive surrogate marker for insulin resistance, often outperforming HOMA-IR in routine settings due to its reliance on standard lipid panels. Strongly correlates with hepatic steatosis (MASLD).</p>
              <p class="text-[13px] text-slate-300"><span class="text-fuchsia-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Next Step</span> If elevated (>4.49), emphasize intensive therapeutic lifestyle changes (Mediterranean diet). Re-evaluate the need for early metformin or GLP-1 RA initiation.</p>
            </div>
          </div>

          <!-- HOMA-IR -->
          <div class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800/80 gap-3">
                <div>
                  <h2 class="text-lg sm:text-xl font-bold text-white">HOMA-IR</h2>
                  <p class="text-xs text-slate-400 mt-0.5">Homeostatic Model Assessment</p>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-3.5 py-2 shrink-0 text-right">
                  <div class="text-2xl sm:text-3xl font-extrabold text-violet-400 tracking-tight leading-none" id="res-homa">-</div>
                  <div class="text-[10px] text-slate-400 mt-0.5 uppercase font-semibold">Cutoff 2.0</div>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Fasting Insulin [mU/L]</label>
                  <input type="number" id="homa-ins" class="input-modern" placeholder="e.g. 15">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-400 mb-1.5">Fasting Glucose [mg/dL]</label>
                  <input type="number" id="homa-glu" class="input-modern" placeholder="e.g. 100">
                </div>
              </div>
            </div>
            
            <div class="pearl-box !border-violet-500 !bg-gradient-to-r !from-violet-500/10 !to-transparent mt-5">
              <p class="text-[13px] text-slate-300 mb-3"><span class="text-violet-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Clinical Pearl</span> Fasting insulin can be highly variable and assays lack standardization. Best used as a baseline population metric or in specific endocrine workups (e.g., PCOS) rather than a daily acute management tool.</p>
              <p class="text-[13px] text-slate-300"><span class="text-violet-400 font-bold uppercase text-[11px] tracking-wider block mb-1">Next Step</span> Target significant weight reduction (5-10% body weight) and assess the utility of insulin sensitizers. Rule out secondary causes of hyperinsulinemia.</p>
            </div>
          </div>
        </div>

        <!-- Friedewald -->
        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8 flex flex-col">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-slate-800/80 gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                Friedewald Equation (LDL)
                <span class="text-[11px] bg-sky-500/10 border border-sky-500/20 text-sky-300 px-2.5 py-0.5 rounded-full font-medium tracking-wide">Lipid Panel</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Estimated LDL Cholesterol (Valid if TG &le; 400 mg/dL)</p>
            </div>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl px-4 py-2.5 sm:px-5 sm:py-3 shrink-0 flex sm:flex-col items-center sm:items-end justify-between sm:justify-center min-w-[140px]">
               <div class="text-3xl sm:text-4xl font-extrabold text-sky-400 tracking-tight leading-none" id="res-ldl">-</div>
               <div class="text-[10px] sm:text-xs text-slate-400 font-semibold mt-1 sm:mt-1.5 uppercase tracking-wide text-right">mg/dL</div>
            </div>
          </div>
          
          <div id="ldl-warning" class="hidden mb-5 p-3 rounded-xl bg-red-950/40 border border-red-500/30 text-red-400 text-sm font-medium flex items-center shadow-lg">
            <i class="fa-solid fa-triangle-exclamation text-lg mr-3"></i> 
            Rumus Friedewald tidak valid untuk Trigliserida > 400 mg/dL.
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Total Cholesterol [mg/dL]</label>
              <input type="number" id="lip-tc" class="input-modern" placeholder="e.g. 200">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">HDL [mg/dL]</label>
              <input type="number" id="lip-hdl" class="input-modern" placeholder="e.g. 45">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1.5">Triglycerides [mg/dL]</label>
              <input type="number" id="lip-tg" class="input-modern" placeholder="e.g. 150">
            </div>
          </div>
          
          <div class="pearl-box !border-sky-500 !bg-gradient-to-r !from-sky-500/10 !to-transparent mt-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-sky-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Tends to underestimate LDL-C when Triglycerides are >200 mg/dL and is completely invalid if TG > 400 mg/dL because the VLDL estimation (TG/5) becomes inaccurate.</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-sky-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">If TG > 400 mg/dL, rely on Non-HDL Cholesterol as the primary target, use the Martin-Hopkins equation, or order a direct LDL-C assay. Initiate fibrates if TG > 500 mg/dL to prevent pancreatitis.</p>
              </div>
            </div>
          </div>
        </div>

      </section>

            <!-- ================= MODULE 4: BRIDGING INSULIN ================= -->
            <section id="tab-bridging-insulin" class="module-section hidden space-y-6 md:space-y-8">
        <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
        </button>

        <div class="glass-card rounded-2xl p-6 sm:p-7 lg:p-8">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-5 border-b border-slate-800/80">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                <i class="fa-solid fa-syringe text-orange-400"></i> Bridging Insulin
                <span class="text-[11px] bg-orange-500/10 border border-orange-500/20 text-orange-400 px-2.5 py-0.5 rounded-full font-medium tracking-wide">IV to SC Transition</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Konversi titrasi drip insulin IV 24 jam ke regimen basal-bolus subkutan.</p>
            </div>
            <div class="flex items-center gap-3">
              <label class="text-xs text-slate-300 flex items-center gap-2">
                <span>Jam Awal:</span>
                <select id="ins-start-hour" onchange="renderInsulinTable()" class="input-modern !py-1 !px-2.5 text-xs w-auto">
                  <option value="23" selected>23:00</option>
                  <option value="0">00:00</option>
                  <option value="6">06:00</option>
                  <option value="7">07:00</option>
                  <option value="8">08:00</option>
                  <option value="12">12:00</option>
                  <option value="18">18:00</option>
                </select>
              </label>
              <button onclick="resetInsulinInputs()" class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">
                <i class="fa-solid fa-rotate-left mr-1"></i> Reset
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Table 24h -->
            <div class="lg:col-span-6 flex flex-col">
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-sm font-semibold text-white">Input Drip Insulin (24 Jam)</h3>
                <span class="text-xs text-slate-400">Satuan: Unit</span>
              </div>
              <div class="rounded-xl border border-slate-800 overflow-hidden bg-slate-950/60 shadow-inner">
                <div class="max-h-[380px] overflow-y-auto custom-scrollbar">
                  <table class="w-full text-sm text-left border-collapse">
                    <thead class="text-xs uppercase bg-slate-900 text-slate-200 sticky top-0 z-10 border-b border-slate-800">
                      <tr>
                        <th class="px-4 py-2.5 w-28 text-center font-bold tracking-wider border-r border-slate-800">Jam</th>
                        <th class="px-4 py-2.5 font-bold tracking-wider">Insulin (U)</th>
                      </tr>
                    </thead>
                    <tbody id="insulin-table-body" class="divide-y divide-slate-800/60">
                      <!-- Dynamic table rows -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Result Summary -->
            <div class="lg:col-span-6 flex flex-col justify-between space-y-5">
              <div class="bg-slate-900/60 rounded-xl p-6 border border-slate-800 space-y-4">
                <h3 class="text-base font-bold text-white border-b border-slate-800 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-calculator text-orange-400"></i> Ringkasan Dosis Subkutan
                </h3>

                <div class="space-y-3 font-mono text-sm">
                  <div class="flex justify-between items-center py-1">
                    <span class="text-slate-300">Total drip 24 jam</span>
                    <span class="text-lg font-bold text-white">: <span id="ins-total">0</span> U</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800">
                    <span class="text-slate-300">Total basal-bolus (80%)</span>
                    <span class="text-xl font-bold text-orange-400">: <span id="ins-bb-80">0</span> U</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800">
                    <span class="text-slate-300">Insulin basal (50%)</span>
                    <span class="text-xl font-bold text-emerald-400">: <span id="ins-basal-50">0</span> U</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800">
                    <span class="text-slate-300">Insulin prandial (per x3)</span>
                    <span class="text-xl font-bold text-cyan-400">: <span id="ins-prandial-3">0</span> U</span>
                  </div>
                </div>

                <div class="text-xs text-slate-400 pt-3 border-t border-slate-800 leading-relaxed italic">
                  Protokol: 80% dosis drip 24 jam sebagai TDD basal-bolus subkutan; 50% sebagai basal (1x/hari), 50% sisanya dibagi rata 3x prandial.
                </div>
                <div class="text-xs font-semibold text-rose-400 bg-rose-500/10 p-3 rounded-lg border border-rose-500/20">
                  <i class="fa-solid fa-triangle-exclamation mr-1"></i> Overlap: Berikan basal 1-2 jam sebelum drip insulin IV dihentikan.
                </div>
              </div>

              <!-- Quick fill helper -->
              <div class="p-4 bg-slate-900/40 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
                <span class="text-slate-400">Set rata-rata drip:</span>
                <div class="flex gap-2">
                  <button onclick="quickFillInsulin(1)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">1 U/jam</button>
                  <button onclick="quickFillInsulin(2)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">2 U/jam</button>
                  <button onclick="quickFillInsulin(3)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">3 U/jam</button>
                </div>
              </div>
            </div>
          </div>

          <!-- CPPT Box -->
          <div class="mt-6 p-5 bg-slate-900/60 rounded-xl border border-slate-800">
            <div class="flex justify-between items-center mb-3">
              <h4 class="font-semibold text-orange-400 text-sm flex items-center gap-2"><i class="fa-solid fa-clipboard-list"></i> Copy ke CPPT</h4>
              <button onclick="copyCPPT('ins-cppt', this)" class="bg-slate-800 hover:bg-slate-700 text-white text-xs py-1.5 px-3 rounded-lg border border-slate-700 transition-colors">
                <i class="fa-solid fa-copy mr-1"></i> Copy
              </button>
            </div>
            <pre id="ins-cppt" class="text-sm text-slate-300 whitespace-pre font-mono bg-slate-950 p-4 rounded-xl border border-slate-800 overflow-x-auto"></pre>
          </div>

          <!-- Pearl Box -->
          <div class="pearl-box !border-orange-500 !bg-gradient-to-r !from-orange-500/10 !to-transparent mt-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <span class="flex items-center text-xs font-bold text-orange-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-microscope mr-2 text-sm"></i> Clinical Pearl</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Transisi dari IV drip ke regimen Subkutan dilakukan saat krisis hiperglikemia (KDA/HHS) sudah terkonversi (pH > 7.30, HCO3 > 18 mEq/L, Anion Gap normal) dan pasien sudah dapat makan secara oral.</p>
              </div>
              <div>
                <span class="flex items-center text-xs font-bold text-orange-400 mb-1.5 uppercase tracking-wider"><i class="fa-solid fa-forward-step mr-2 text-sm"></i> Next Step</span>
                <p class="text-[13px] text-slate-300 leading-relaxed">Berikan dosis insulin basal subkutan pertama 1-2 jam sebelum drip insulin IV distop total untuk mencegah terjadinya rebound hiperglikemia atau kecenderungan ketoasidosis berulang.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

        </main>
    </div>

    <!-- SCRIPT ENGINE -->
    <script>
    // ==========================================
    // GLOBAL TOOL REGISTRY & SEARCH ENGINE
    // ==========================================
    const CALCULATORS_DB = [
      { id: 'tab-thyroid', name: 'Burch-Wartofsky Scale (BWPS)', category: 'Tiroid & Krisis', color: 'rose', pillId: 'pill-thyroid', desc: 'Skor diagnostik badai tiroid (thyroid storm) berdasarkan kriteria suhu, SSP, GI, takikardia, gagal jantung, dan AF.', keywords: ['bwps', 'burch-wartofsky', 'badai tiroid', 'thyroid storm', 'tirotoksikosis', 'krisis tiroid', 'ptu'] },
      { id: 'tab-thyroid', name: "Wayne's Clinical Index", category: 'Tiroid & Krisis', color: 'cyan', pillId: 'pill-thyroid', desc: 'Evaluasi klinis hipertiroidisme berdasarkan anamnesis gejala dan pemeriksaan tanda fisik tanpa lab.', keywords: ['wayne', 'hipertiroid', 'eutiroid', 'toksik', 'tremor', 'tiroid', 'palpitasi'] },
      { id: 'tab-thyroid', name: 'Billewicz Diagnostic Score', category: 'Tiroid & Krisis', color: 'indigo', pillId: 'pill-thyroid', desc: 'Skor diagnostik hipotiroidisme klinis berdasarkan gejala konstitusional dan refleks tendo Achilles (Woltman).', keywords: ['billewicz', 'hipotiroid', 'woltman', 'ankle jerk', 'levothyroxine', 'keringat berkurang'] },
      { id: 'tab-emergencies', name: 'Effective Serum Osmolarity', category: 'Emergensi Metabolik', color: 'amber', pillId: 'pill-emergencies', desc: 'Osmolaritas efektif (tonisitas) untuk stratifikasi krisis hiperglikemia HHS vs DKA dan korelasi kesadaran.', keywords: ['osmolaritas', 'osmo', 'hhs', 'dka', 'hiperglikemia', 'koma', 'tonisitas'] },
      { id: 'tab-emergencies', name: 'Anion Gap & Corrected Sodium', category: 'Emergensi Metabolik', color: 'emerald', pillId: 'pill-emergencies', desc: 'Evaluasi asidosis metabolik anion gap (AGMA) dan koreksi pseudohiponatremia hiperglikemik akut.', keywords: ['anion gap', 'corrected na', 'pseudohiponatremia', 'cna', 'katz', 'dka', 'asidosis'] },
      { id: 'tab-emergencies', name: 'Insulin Basal-Bolus TDD', category: 'Emergensi Metabolik', color: 'rose', pillId: 'pill-emergencies', desc: 'Distribusi total daily dose (TDD) fisiologis: 50% basal (1x/hari) dan 50% bolus prandial terbagi 3 makan.', keywords: ['tdd', 'insulin', 'basal bolus', 'dosis harian', 'glargine', 'aspart', 'sliding scale'] },
      { id: 'tab-metabolic', name: 'Triglyceride-Glucose (TyG) Index', category: 'Kardiometabolik & Lipid', color: 'fuchsia', pillId: 'pill-metabolic', desc: 'Surrogate marker resistensi insulin dan perlemakan hati metabolik (MASLD) dari trigliserida dan glukosa.', keywords: ['tyg', 'triglyceride glucose', 'resistensi insulin', 'masld', 'nafld', 'kardiometabolik'] },
      { id: 'tab-metabolic', name: 'HOMA-IR Assessment', category: 'Kardiometabolik & Lipid', color: 'violet', pillId: 'pill-metabolic', desc: 'Penentuan kuantitatif resistensi insulin dari kadar insulin puasa dan glukosa puasa (Matthews formula).', keywords: ['homa-ir', 'homa', 'insulin puasa', 'fasting insulin', 'pcos', 'prediabetes'] },
      { id: 'tab-metabolic', name: 'Friedewald Estimated LDL-C', category: 'Kardiometabolik & Lipid', color: 'sky', pillId: 'pill-metabolic', desc: 'Estimasi kadar kolesterol LDL dari profil lipid standar dengan guardrail batas aman TG > 400 mg/dL.', keywords: ['friedewald', 'ldl', 'kolesterol', 'profil lipid', 'trigliserida', 'non-hdl'] },
      { id: 'tab-bridging-insulin', name: 'Bridging Insulin IV ke Subkutan', category: 'Protokol Khusus', color: 'orange', pillId: 'pill-bridging-insulin', desc: 'Titrasi drip insulin 24 jam ke regimen subkutan basal-bolus 80% dengan instruksi overlap aman.', keywords: ['bridging', 'bridging insulin', 'drip insulin', 'transisi subkutan', 'kda', 'hhs', 'overlap'] }
    ];

    function showToast(msg) {
        const toastEl = document.getElementById('toast-notice');
        const toastMsg = document.getElementById('toast-message');
        if (toastEl && toastMsg) {
            toastMsg.textContent = msg;
            toastEl.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            toastEl.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toastEl.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
                toastEl.classList.remove('translate-y-0', 'opacity-100');
            }, 3000);
        }
    }

    // Direct Navigation matching adjustr-GEH
    window.navigateTo = function (targetId, title, activePillId = null) {
        document.querySelectorAll('.module-section').forEach(sec => {
            sec.classList.add('hidden');
            sec.classList.remove('block');
        });

        const targetSection = document.getElementById(targetId);
        if (targetSection) {
            targetSection.classList.remove('hidden');
            targetSection.classList.add('block');
        }

        const headerTitle = document.getElementById('header-title');
        if (headerTitle && title) {
            headerTitle.textContent = title;
        }

        document.querySelectorAll('.quick-nav-pill').forEach(pill => pill.classList.remove('active'));
        if (activePillId) {
            const el = document.getElementById(activePillId);
            if (el) el.classList.add('active');
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    function initGlobalSearch() {
        const searchInput = document.getElementById('global-search-input');
        const searchDropdown = document.getElementById('search-results-dropdown');
        const clearBtn = document.getElementById('search-clear-btn');

        if (!searchInput || !searchDropdown) return;

        function renderResults(query) {
            const clean = query.trim().toLowerCase();
            if (!clean) {
                searchDropdown.classList.add('hidden');
                searchDropdown.innerHTML = '';
                if (clearBtn) clearBtn.classList.add('hidden');
                return;
            }

            if (clearBtn) clearBtn.classList.remove('hidden');

            const matches = CALCULATORS_DB.filter(tool => {
                return tool.name.toLowerCase().includes(clean) ||
                       tool.category.toLowerCase().includes(clean) ||
                       tool.desc.toLowerCase().includes(clean) ||
                       tool.keywords.some(k => k.toLowerCase().includes(clean));
            });

            if (matches.length === 0) {
                searchDropdown.innerHTML = '<div class="p-3 text-xs text-slate-400 text-center">Tidak ditemukan kalkulator untuk "' + query + '".</div>';
                searchDropdown.classList.remove('hidden');
                return;
            }

            let html = '<div class="space-y-1">';
            matches.forEach(tool => {
                html += `
                    <button type="button" onclick="selectSearchResult('${tool.id}', '${tool.name.replace(/'/g, "\\'")}', '${tool.pillId}')" class="w-full p-2.5 rounded-lg bg-slate-800/60 hover:bg-emerald-500/20 border border-slate-700/50 hover:border-emerald-500/50 text-left transition-all group flex items-start space-x-3">
                        <div class="h-7 w-7 rounded-md bg-${tool.color}-500/20 text-${tool.color}-400 flex items-center justify-center shrink-0 text-xs mt-0.5">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center space-x-2">
                                <span class="text-xs font-bold text-white group-hover:text-emerald-400 transition-colors truncate">${tool.name}</span>
                                <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-700 text-slate-300 font-medium shrink-0">${tool.category}</span>
                            </div>
                            <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">${tool.desc}</p>
                        </div>
                        <i class="fa-solid fa-arrow-right text-xs text-slate-500 group-hover:text-emerald-400 mt-1 shrink-0"></i>
                    </button>
                `;
            });
            html += '</div>';

            searchDropdown.innerHTML = html;
            searchDropdown.classList.remove('hidden');
        }

        searchInput.addEventListener('input', (e) => {
            renderResults(e.target.value);
        });

        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                searchInput.focus();
                searchInput.select();
            }
            if (e.key === 'Escape' && !searchDropdown.classList.contains('hidden')) {
                searchDropdown.classList.add('hidden');
            }
        });

        document.addEventListener('click', (e) => {
            const container = document.getElementById('header-search-container');
            if (container && !container.contains(e.target)) {
                searchDropdown.classList.add('hidden');
            }
        });
    }

    window.clearGlobalSearch = function () {
        const input = document.getElementById('global-search-input');
        if (input) {
            input.value = '';
            input.focus();
            const dropdown = document.getElementById('search-results-dropdown');
            if (dropdown) {
                dropdown.classList.add('hidden');
                dropdown.innerHTML = '';
            }
            const clearBtn = document.getElementById('search-clear-btn');
            if (clearBtn) clearBtn.classList.add('hidden');
        }
    };

    window.selectSearchResult = function (targetId, name, pillId) {
        const searchDropdown = document.getElementById('search-results-dropdown');
        if (searchDropdown) searchDropdown.classList.add('hidden');
        navigateTo(targetId, name, pillId);
    };

    // Helper for Real-time listeners
    function addRealTimeListeners(selector, callback) {
      document.querySelectorAll(selector).forEach(el => {
        el.addEventListener('input', callback);
        if(el.tagName === 'SELECT') {
            el.addEventListener('change', callback);
        }
      });
    }

    // ==========================================
    // 1. BURCH-WARTOFSKY POINT SCALE (BWPS)
    // ==========================================
    function calcBWPS() {
      let score = 0;
      score += parseInt(document.getElementById('bwps-temp')?.value) || 0;
      score += parseInt(document.getElementById('bwps-cns')?.value) || 0;
      score += parseInt(document.getElementById('bwps-gi')?.value) || 0;
      score += parseInt(document.getElementById('bwps-hr')?.value) || 0;
      score += parseInt(document.getElementById('bwps-chf')?.value) || 0;
      if (document.getElementById('bwps-af')?.checked) score += parseInt(document.getElementById('bwps-af').value);
      if (document.getElementById('bwps-precipitant')?.checked) score += parseInt(document.getElementById('bwps-precipitant').value);

      const resEl = document.getElementById('res-bwps');
      const interpEl = document.getElementById('res-bwps-interp');
      if (!resEl || !interpEl) return;
      
      resEl.textContent = score;

      if (score >= 45) {
        interpEl.textContent = "Highly suggestive of Thyroid Storm";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-rose-400 font-bold";
        resEl.className = "text-4xl font-bold text-rose-400 tracking-tighter";
      } else if (score >= 25) {
        interpEl.textContent = "Impending Thyroid Storm";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-amber-400 font-bold";
        resEl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
      } else {
        interpEl.textContent = "Thyroid Storm Unlikely";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-emerald-400 font-bold";
        resEl.className = "text-4xl font-bold text-emerald-400 tracking-tighter";
      }
    }
    addRealTimeListeners('.bwps-input', calcBWPS);

    // ==========================================
    // 2. WAYNE'S CLINICAL INDEX
    // ==========================================
    function calcWayne() {
      let score = 0;
      document.querySelectorAll('.wayne-input[type="checkbox"]:checked').forEach(cb => {
        score += parseInt(cb.value) || 0;
      });
      score += parseInt(document.getElementById('wayne-pulse')?.value) || 0;

      const resEl = document.getElementById('res-wayne');
      const interpEl = document.getElementById('res-wayne-interp');
      if (!resEl || !interpEl) return;
      
      resEl.textContent = score;

      if (score > 19) {
        interpEl.textContent = "Toxic (Hyperthyroidism)";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-rose-400 font-bold";
        resEl.className = "text-4xl font-bold text-rose-400 tracking-tighter";
      } else if (score >= 11) {
        interpEl.textContent = "Equivocal";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-amber-400 font-bold";
        resEl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
      } else {
        interpEl.textContent = "Euthyroid";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-cyan-400 font-bold";
        resEl.className = "text-4xl font-bold text-cyan-400 tracking-tighter";
      }
    }
    addRealTimeListeners('.wayne-input', calcWayne);

    // ==========================================
    // 3. BILLEWICZ SCORE
    // ==========================================
    function calcBillewicz() {
      let score = 0;
      document.querySelectorAll('.billewicz-input').forEach(sel => {
        score += parseInt(sel.value) || 0;
      });

      const resEl = document.getElementById('res-billewicz');
      const interpEl = document.getElementById('res-billewicz-interp');
      if (!resEl || !interpEl) return;
      
      resEl.textContent = (score > 0 ? '+' : '') + score;

      if (score >= 25) {
        interpEl.textContent = "Hypothyroid";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-rose-400 font-bold";
        resEl.className = "text-4xl font-bold text-rose-400 tracking-tighter";
      } else if (score > -30) {
        interpEl.textContent = "Equivocal";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-amber-400 font-bold";
        resEl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
      } else {
        interpEl.textContent = "Euthyroid";
        interpEl.className = "text-xs uppercase tracking-wider mt-1 text-indigo-400 font-bold";
        resEl.className = "text-4xl font-bold text-indigo-400 tracking-tighter";
      }
    }
    addRealTimeListeners('.billewicz-input', calcBillewicz);

    // ==========================================
    // 4. OSMOLARITAS SERUM EFEKTIF
    // ==========================================
    function calcOsmo() {
      const na = parseFloat(document.getElementById('osmo-na')?.value);
      const glu = parseFloat(document.getElementById('osmo-glu')?.value);
      const resEl = document.getElementById('res-osmo');
      if (!resEl) return;

      if (!isNaN(na) && !isNaN(glu)) {
        const osmo = (2 * na) + (glu / 18);
        resEl.textContent = osmo.toFixed(1);
        if(osmo >= 320) {
          resEl.className = "text-4xl font-bold text-rose-500 tracking-tighter";
        } else {
          resEl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
        }
      } else {
        resEl.textContent = "-";
        resEl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
      }
    }
    addRealTimeListeners('#osmo-na, #osmo-glu', calcOsmo);

    // ==========================================
    // 5. ANION GAP & CORRECTED SODIUM
    // ==========================================
    function calcAG() {
      const na = parseFloat(document.getElementById('ag-na')?.value);
      const cl = parseFloat(document.getElementById('ag-cl')?.value);
      const hco3 = parseFloat(document.getElementById('ag-hco3')?.value);
      const glu = parseFloat(document.getElementById('ag-glu')?.value);

      const agEl = document.getElementById('res-ag');
      const cnaEl = document.getElementById('res-cna');

      if (!isNaN(na) && !isNaN(cl) && !isNaN(hco3) && agEl) {
        const ag = na - (cl + hco3);
        agEl.textContent = ag.toFixed(1);
      } else if (agEl) {
        agEl.textContent = "-";
      }

      if (!isNaN(na) && !isNaN(glu) && glu > 100 && cnaEl) {
        const cNa = na + 1.6 * ((glu - 100) / 100);
        cnaEl.textContent = cNa.toFixed(1);
      } else if (!isNaN(na) && cnaEl) {
        cnaEl.textContent = na.toFixed(1);
      } else if (cnaEl) {
        cnaEl.textContent = "-";
      }
    }
    addRealTimeListeners('#ag-na, #ag-cl, #ag-hco3, #ag-glu', calcAG);

    // ==========================================
    // 6. INSULIN BASAL-BOLUS TDD
    // ==========================================
    function calcInsulin() {
      const wt = parseFloat(document.getElementById('ins-wt')?.value);
      const factor = parseFloat(document.getElementById('ins-factor')?.value);

      const tddEl = document.getElementById('res-tdd');
      const basalEl = document.getElementById('res-basal');
      const bolusEl = document.getElementById('res-bolus');

      if (!isNaN(wt) && !isNaN(factor) && tddEl && basalEl && bolusEl) {
        const tdd = wt * factor;
        const basal = tdd * 0.5;
        const bolus = (tdd * 0.5) / 3;

        tddEl.textContent = Math.round(tdd);
        basalEl.innerHTML = `${Math.round(basal)} <span class="text-sm font-medium text-slate-400 ml-1">U Qd</span>`;
        bolusEl.innerHTML = `${Math.round(bolus)} <span class="text-sm font-medium text-slate-400 ml-1">U TID</span>`;
      } else if (tddEl && basalEl && bolusEl) {
        tddEl.textContent = "-";
        basalEl.innerHTML = `- <span class="text-sm font-medium text-slate-400 ml-1">U Qd</span>`;
        bolusEl.innerHTML = `- <span class="text-sm font-medium text-slate-400 ml-1">U TID</span>`;
      }
    }
    addRealTimeListeners('#ins-wt, #ins-factor', calcInsulin);

    // ==========================================
    // 7, 8, 9. METABOLIC: TYG, HOMA-IR, FRIEDEWALD
    // ==========================================
    function calcMetabolic() {
      // TyG
      const tgTyg = parseFloat(document.getElementById('tyg-tg')?.value);
      const gluTyg = parseFloat(document.getElementById('tyg-glu')?.value);
      const tygEl = document.getElementById('res-tyg');
      if (tygEl) {
        if (!isNaN(tgTyg) && !isNaN(gluTyg)) {
          const tyg = Math.log(tgTyg * gluTyg) / 2;
          tygEl.textContent = tyg.toFixed(2);
        } else {
          tygEl.textContent = "-";
        }
      }

      // HOMA-IR
      const insHoma = parseFloat(document.getElementById('homa-ins')?.value);
      const gluHoma = parseFloat(document.getElementById('homa-glu')?.value);
      const homaEl = document.getElementById('res-homa');
      if (homaEl) {
        if (!isNaN(insHoma) && !isNaN(gluHoma)) {
          const homa = (insHoma * gluHoma) / 405;
          homaEl.textContent = homa.toFixed(2);
        } else {
          homaEl.textContent = "-";
        }
      }

      // Friedewald
      const tc = parseFloat(document.getElementById('lip-tc')?.value);
      const hdl = parseFloat(document.getElementById('lip-hdl')?.value);
      const tgLip = parseFloat(document.getElementById('lip-tg')?.value);
      
      const resLdl = document.getElementById('res-ldl');
      const ldlWarn = document.getElementById('ldl-warning');

      if (!isNaN(tc) && !isNaN(hdl) && !isNaN(tgLip) && resLdl) {
        if (tgLip > 400) {
          resLdl.textContent = "N/A";
          resLdl.className = "text-4xl font-bold text-slate-600 tracking-tighter";
          if (ldlWarn) ldlWarn.classList.remove('hidden');
        } else {
          const ldl = tc - hdl - (tgLip / 5);
          if (ldl < 0) {
            resLdl.textContent = "< 0";
            resLdl.className = "text-4xl font-bold text-amber-400 tracking-tighter";
            if (ldlWarn) {
              ldlWarn.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-lg mr-3"></i> Hasil kalkulasi LDL negatif (< 0 mg/dL). Rumus Friedewald tidak valid untuk sampel ini.';
              ldlWarn.classList.remove('hidden');
            }
          } else {
            resLdl.textContent = ldl.toFixed(1);
            resLdl.className = "text-4xl font-bold text-sky-400 tracking-tighter";
            if (ldlWarn) ldlWarn.classList.add('hidden');
          }
        }
      } else if (resLdl) {
        resLdl.textContent = "-";
        resLdl.className = "text-4xl font-bold text-sky-400 tracking-tighter";
        if (ldlWarn) ldlWarn.classList.add('hidden');
      }
    }
    addRealTimeListeners('#tyg-tg, #tyg-glu, #homa-ins, #homa-glu, #lip-tc, #lip-hdl, #lip-tg', calcMetabolic);

    // ==========================================
    // 10. BRIDGING INSULIN TRANSITION
    // ==========================================
    function copyCPPT(elementId, btnElement) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const textToCopy = el.innerText;
      
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          showToast('Resume klinis CPPT berhasil disalin!');
        }).catch(fallbackCopy);
      } else {
        fallbackCopy();
      }

      function fallbackCopy() {
        const textArea = document.createElement("textarea");
        textArea.value = textToCopy;
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          showToast('Resume klinis CPPT berhasil disalin!');
        } catch (err) {
          console.error('Gagal menyalin:', err);
        }
        document.body.removeChild(textArea);
      }
    }

    function fmtIndo(num, digits = 1) {
      if (isNaN(num) || !isFinite(num)) return "0";
      return Number(num).toFixed(digits).replace('.', ',');
    }

    function renderInsulinTable() {
      const startHourSelect = document.getElementById('ins-start-hour');
      if (!startHourSelect) return;
      const startHour = parseInt(startHourSelect.value, 10) || 0;
      const tbody = document.getElementById('insulin-table-body');
      if (!tbody) return;
      
      const currentVals = [];
      tbody.querySelectorAll('.ins-hourly-input').forEach(input => {
        currentVals.push(input.value);
      });

      let html = '';
      for (let i = 0; i < 24; i++) {
        let h = (startHour + i) % 24;
        let hourStr = `${h.toString().padStart(2, '0')}:00`;
        let val = currentVals[i] !== undefined ? currentVals[i] : '0';
        
        html += `
          <tr class="hover:bg-slate-900/60 transition-colors">
            <td class="px-4 py-2 font-mono text-slate-300 text-center bg-slate-950/40 border-r border-slate-800">${hourStr}</td>
            <td class="px-3 py-1.5">
              <input type="number" class="ins-hourly-input input-modern !py-1 text-center font-mono" value="${val}" min="0" step="0.5">
            </td>
          </tr>
        `;
      }
      tbody.innerHTML = html;

      tbody.querySelectorAll('.ins-hourly-input').forEach(inp => {
        inp.addEventListener('input', calcBridgingInsulin);
      });

      calcBridgingInsulin();
    }

    function resetInsulinInputs() {
      document.querySelectorAll('.ins-hourly-input').forEach(input => {
        input.value = "0";
      });
      calcBridgingInsulin();
    }

    function quickFillInsulin(val) {
      document.querySelectorAll('.ins-hourly-input').forEach(input => {
        input.value = val;
      });
      calcBridgingInsulin();
    }

    function calcBridgingInsulin() {
      let total = 0;
      document.querySelectorAll('.ins-hourly-input').forEach(input => {
        total += parseFloat(input.value) || 0;
      });

      const totalBB = total * 0.8;
      const basal = totalBB * 0.5;
      const prandial = basal / 3;

      const totalEl = document.getElementById('ins-total');
      if (!totalEl) return;

      totalEl.innerText = fmtIndo(total, 1);
      document.getElementById('ins-bb-80').innerText = fmtIndo(totalBB, 1);
      document.getElementById('ins-basal-50').innerText = fmtIndo(basal, 1);
      document.getElementById('ins-prandial-3').innerText = fmtIndo(prandial, 1);

      let cppt = `BRIDGING INSULIN (TRANSISI KE SUBKUTAN)\n\n`;
      cppt += `Total drip 24 jam       : ${fmtIndo(total, 1)} U\n`;
      cppt += `Total basal-bolus (80%) : ${fmtIndo(totalBB, 1)} U\n`;
      cppt += `Insulin basal (50%)     : ${fmtIndo(basal, 1)} U (diberikan 1x/hari SC)\n`;
      cppt += `Insulin prandial (/x3)  : ${fmtIndo(prandial, 1)} U (tiap makan SC)\n\n`;
      cppt += `Instruksi Overlap:\n`;
      cppt += `- Berikan dosis insulin basal subkutan 1 - 2 jam sebelum drip IV dihentikan.\n`;
      cppt += `- Pastikan pasien toleransi intake oral saat beralih ke regimen subkutan.`;

      const cpptEl = document.getElementById('ins-cppt');
      if (cpptEl) cpptEl.innerText = cppt;
    }

    // Init All on DOM Load
    document.addEventListener('DOMContentLoaded', () => {
      initGlobalSearch();
      calcBWPS();
      calcWayne();
      calcBillewicz();
      calcOsmo();
      calcAG();
      calcInsulin();
      calcMetabolic();
      renderInsulinTable();
    });
    </script>
</body>
</html>
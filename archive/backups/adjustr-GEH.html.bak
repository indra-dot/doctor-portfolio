            <!-- Hub 5: Functional GI -->
            <section id="hub-functional" class="module-section hidden">
                <div class="flex items-center justify-between mb-5">
                    <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
                        <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
                    </button>
                    <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30">4 Modul</span>
                </div>
                <h3 class="text-lg font-bold text-white mb-2 font-['Plus_Jakarta_Sans']">Functional GI & Motility Tools</h3>
                <p class="text-xs text-slate-400 mb-5">Instrumen diagnostik kriteria Rome IV (IBS & Dispepsia Fungsional) dan konsensus diagnosis objektif GERD (Lyon Consensus & LA Class):</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Rome IV IBS -->
                    <button type="button" onclick="navigateTo('rome4-ibs-module', 'Rome IV: Irritable Bowel Syndrome (IBS)', 'pill-functional', 'hub-functional')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group border-pink-500/30">
                        <div class="h-10 w-10 rounded-lg bg-pink-500/10 text-pink-400 border border-pink-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-arrows-split-up-and-left"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-1.5 mb-1">
                                <h4 class="font-bold text-white text-sm group-hover:text-cyan-400 transition-colors">Rome IV Criteria: IBS</h4>
                                <span class="px-1.5 py-0.2 bg-pink-500/20 text-pink-300 text-[10px] font-bold rounded">IBS-C/D/M/U</span>
                            </div>
                            <p class="text-xs text-slate-400">Diagnosis Irritable Bowel Syndrome, subtipe feses Bristol, alarm red flags, & algoritma terapi.</p>
                        </div>
                    </button>

                    <!-- Rome IV Dyspepsia -->
                    <button type="button" onclick="navigateTo('rome4-dyspepsia-module', 'Rome IV: Functional Dyspepsia (PDS vs EPS)', 'pill-functional', 'hub-functional')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group border-pink-500/30">
                        <div class="h-10 w-10 rounded-lg bg-pink-500/10 text-pink-400 border border-pink-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-clipboard-question"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-1.5 mb-1">
                                <h4 class="font-bold text-white text-sm group-hover:text-cyan-400 transition-colors">Rome IV: Functional Dyspepsia</h4>
                                <span class="px-1.5 py-0.2 bg-pink-500/20 text-pink-300 text-[10px] font-bold rounded">PDS vs EPS</span>
                            </div>
                            <p class="text-xs text-slate-400">Diferensiasi Postprandial Distress (PDS) vs Epigastric Pain (EPS), skrining alarm, & panduan terapi.</p>
                        </div>
                    </button>

                    <!-- Lyon Consensus 2.0 -->
                    <button type="button" onclick="navigateTo('lyon-module', 'Lyon Consensus: Objective GERD Diagnosis', 'pill-functional', 'hub-functional')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group border-cyan-500/30">
                        <div class="h-10 w-10 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-wave-square"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-1.5 mb-1">
                                <h4 class="font-bold text-white text-sm group-hover:text-cyan-400 transition-colors">Lyon Consensus: GERD Criteria</h4>
                                <span class="px-1.5 py-0.2 bg-cyan-500/20 text-cyan-300 text-[10px] font-bold rounded">Lyon 2.0</span>
                            </div>
                            <p class="text-xs text-slate-400">Kriteria diagnostik objektif GERD: EGD, AET %, refluks episode, fenotip RH vs Functional Heartburn.</p>
                        </div>
                    </button>

                    <!-- Los Angeles (LA) Classification -->
                    <button type="button" onclick="navigateTo('la-module', 'Los Angeles Classification (GERD)', 'pill-functional', 'hub-functional')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group">
                        <div class="h-10 w-10 rounded-lg bg-pink-500/10 text-pink-400 border border-pink-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-water"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-white text-sm mb-1 group-hover:text-cyan-400 transition-colors">Los Angeles (LA) Class (GERD)</h4>
                            <p class="text-xs text-slate-400">Derajat esofagitis refluks pada EGD (Grade A-D), durasi terapi PPI, dan panduan surveilans.</p>
                        </div>
                    </button>
                </div>
            </section>

            <!-- Hub 5: Endoscopy -->
            <section id="hub-endo" class="module-section hidden">
                <div class="flex items-center justify-between mb-5">
                    <button type="button" onclick="navigateTo('home-module', 'Home Dashboard', 'pill-dash')" class="btn-back">
                        <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
                    </button>
                    <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30">1 Modul</span>
                </div>
                <h3 class="text-lg font-bold text-white mb-2 font-['Plus_Jakarta_Sans']">Endoscopy Surveillance Tools</h3>
                <p class="text-xs text-slate-400 mb-5">Panduan surveilans kolonoskopi pasca polipektomi:</p>

                <div class="max-w-xl">
                    <button type="button" onclick="navigateTo('polyp-module', 'Polyp Surveillance (USMSTF)', 'pill-endo', 'hub-endo')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group w-full">
                        <div class="h-10 w-10 rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-white text-sm mb-1 group-hover:text-cyan-400 transition-colors">Post-Polypectomy Surveillance (USMSTF)</h4>
                            <p class="text-xs text-slate-400">Kalkulator interval pengulangan kolonoskopi berdasarkan histologi dan jumlah polip.</p>

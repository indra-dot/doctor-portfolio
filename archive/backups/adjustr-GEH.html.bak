                            <i class="fa-solid fa-list-check"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-white text-sm mb-1 group-hover:text-cyan-400 transition-colors">Mayo Score for UC</h4>
                            <p class="text-xs text-slate-400">Skor kuantitatif aktivitas penyakit Kolitis Ulseratif (Full Mayo vs Partial Mayo).</p>
                        </div>
                    </button>

                    <button type="button" onclick="navigateTo('cdai-module', 'Crohn\'s Disease Activity (HBI/CDAI)', 'pill-ibd', 'hub-ibd')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group">
                        <div class="h-10 w-10 rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-stethoscope"></i>

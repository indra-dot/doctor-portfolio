                        <div>
                            <h4 class="font-bold text-white text-sm mb-1 group-hover:text-cyan-400 transition-colors">Crohn's Disease (HBI / CDAI)</h4>
                            <p class="text-xs text-slate-400">Evaluasi cepat Harvey-Bradshaw Index (HBI) dan ekuivalensi standar Full CDAI.</p>
                        </div>
                    </button>

                    <button type="button" onclick="navigateTo('calprotectin-module', 'Fecal Calprotectin Interpreter', 'pill-ibd', 'hub-ibd')" class="glass-card rounded-xl p-5 flex items-start text-left cursor-pointer group">
                        <div class="h-10 w-10 rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center text-lg mr-4 shrink-0 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-vial"></i>
